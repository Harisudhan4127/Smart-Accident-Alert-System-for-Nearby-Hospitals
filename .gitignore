.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/
doc/api/

# Generated by `flutter gen-l10n`, if the localisation layer is ever added.
lib/l10n/generated/
*.g.dart
*.freezed.dart

# ── Android ──────────────────────────────────────────────────────────────────
app/android/.gradle/
app/android/local.properties
app/android/**/GeneratedPluginRegistrant.java
app/android/.idea/
app/android/captures/
app/android/key.properties
# Signing material must never be committed. See `signing` in the release notes.
*.jks
*.keystore
app/android/app/release/
app/android/app/debug/
app/android/app/profile/

# ── iOS ──────────────────────────────────────────────────────────────────────
app/ios/Pods/
app/ios/.symlinks/
app/ios/**/Flutter/ephemeral/
app/ios/Flutter/ephemeral/
