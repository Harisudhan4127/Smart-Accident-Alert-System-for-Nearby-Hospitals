app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner.xcworkspace/xcuserdata/
app/ios/Runner/GeneratedPluginRegistrant.*
app/ios/ios.xcworkspace/xcuserdata/
app/ios/Podfile.lock  # see note at the bottom
app/ios/**/xcuserdata/
*.mobileprovision
*.p12

# ── Firebase / secrets ───────────────────────────────────────────────────────
# These are project identifiers, not secrets, but they are environment-specific
# and the open-source repo should not silently inherit one project's config.
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
app/**/serviceAccountKey*.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# ── ESP32 firmware ───────────────────────────────────────────────────────────
# Arduino build output. `.ino` sketches compile to these in a temp dir, and
# PlatformIO puts them under `.pio/`.
*.elf
*.eep
*.hex
firmware/**/*.bin
firmware/**/hardware/**/*

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
platformio.ini.local
secrets.h

# ── Native / desktop ─────────────────────────────────────────────────────────
