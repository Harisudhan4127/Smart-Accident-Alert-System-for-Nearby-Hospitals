# Copy to .env.<your-project-id> and fill in. .env.* is gitignored.
#
# Plain string parameters only. Anything secret belongs in Secret Manager
# (firebase functions:secrets:set), not here.

# Comma-separated CORS allow-list for the public nearbyHospitals endpoint.
# Empty means "reflect whatever origin asked", which is equivalent to * with
# credentials refused — fine for a project with no web client, wrong the moment
# there is one.
ALLOWED_ORIGINS=http://localhost:8080
